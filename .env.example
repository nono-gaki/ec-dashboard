# HRMOS勤怠(IEYASU) API連携用の環境変数
# 実際の値はこのファイルには書かず、Netlifyの
# Project configuration > Environment variables で設定してください。
# ローカルで netlify dev を使ってテストする場合のみ、
# このファイルをコピーして .env を作成し、値を記入してください（.envはgit管理外です）。

# HRMOS勤怠の会社URL（例: https://p.ieyasu.co/... の "p" の部分）
HRMOS_COMPANY_URL=

# HRMOS勤怠 API設定画面で発行したシークレットキー
HRMOS_SECRET_KEY=
